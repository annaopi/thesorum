# THESORUM LLM configuration. Copy to .env and fill in. Never commit .env.
# Leave everything unset (or run with --no-ai) for demo mode: rule-based agents, no network.

# anthropic | openai   ("openai" also covers any OpenAI-compatible API via LLM_BASE_URL)
LLM_PROVIDER=openai
LLM_API_KEY=
# Required, no default: use a model name your provider offers.
LLM_MODEL=

# Optional. Base URL WITHOUT the endpoint path (https; http only for localhost).
#   openai default:    https://api.openai.com/v1
#   anthropic default: https://api.anthropic.com
# LLM_BASE_URL=
# LLM_TIMEOUT_MS=45000
# LLM_MAX_TOKENS=4096
# LLM_TEMPERATURE=
